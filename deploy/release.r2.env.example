# Use the IDs from ONE passing frontend R2 CI artifact.
FRONT_IMAGE=sha256:VERIFIED_FRONT_ID
BACK_IMAGE=sha256:VERIFIED_BACK_ID
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8081
# Absolute paths on the existing VPS; never commit their contents.
DB_PASSWORD_FILE=/opt/foxy/secrets/r2-db-password
DATABASE_URL_FILE=/opt/foxy/secrets/r2-database-url
