# IDs from ONE passing R3/R4 frontend CI artifact.
FRONT_IMAGE=sha256:VERIFIED_FRONT_ID
BACK_IMAGE=sha256:VERIFIED_BACK_ID
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8081
DB_PASSWORD_FILE=/opt/foxy/secrets/db-password
DATABASE_URL_FILE=/opt/foxy/secrets/migrator-database-url
RUNTIME_DATABASE_URL_FILE=/opt/foxy/secrets/runtime-database-url
# Protected hashed account file, mode 0400/0600, readable by container UID1000.
PROVISION_FILE=/opt/foxy/secrets/accounts.json
